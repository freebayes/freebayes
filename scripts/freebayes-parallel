#!/usr/bin/env bash

set -euo pipefail

if [ $# -lt 3 ];
then
    echo "usage: $0 [regions file] [ncpus] [freebayes arguments]"
    echo
    echo "Run freebayes in parallel over regions listed in regions file, using ncpus processors."
    echo "Will merge and sort output, producing a uniform VCF stream on stdout.  Flags to freebayes"
    echo "which would write to e.g. a particular file will obviously cause problms, so caution is"
    echo "encouraged when using this script."
    echo
    echo "examples:"
    echo
    echo "Run freebayes in parallel on 100000bp chunks of the ref (fasta_generate_regions.py is also"
    echo "located in the scripts/ directory in the freebayes distribution).  Use 36 threads."
    echo
    echo "    freebayes-parallel <(fasta_generate_regions.py ref.fa.fai 100000) 36 -f ref.fa aln.bam >out.vcf"
    echo
    echo "Generate regions that are equal in terms of data content, and thus have lower variance"
    echo "in runtime.  This will yield better resource utilization."
    echo
    echo "    bamtools coverage -in aln.bam | coverage_to_regions.py ref.fa.fai 500 >ref.fa.500.regions"
    echo "    freebayes-parallel ref.fa.500.regions 36 -f ref.fa aln.bam >out.vcf"
    echo
    echo "Regions are processed with an upstream overlap so that variants at region boundaries are"
    echo "called as in a single run. The overlap defaults to 1000 bp and must be at least the read"
    echo "length; set FREEBAYES_PARALLEL_OVERLAP to change it, e.g. for long reads."
    echo
    exit
fi

regionsfile=$1
shift
ncpus=$1
shift

# Each region is run with an upstream overlap: freebayes is started this many bases before the
# region's nominal start, and only the records at or after the nominal start are kept. Reads
# that overlap a region boundary are otherwise invisible to the downstream region for the part
# already parsed before the boundary, so a variant cluster straddling a boundary comes out
# duplicated (the upstream region reports the whole cluster, the downstream one reports its
# tail again) or, when only such reads support it, not at all. With an overlap of at least the
# read length the downstream region sees the same reads at its nominal start as a single run.
overlap=${FREEBAYES_PARALLEL_OVERLAP:-1000}

# Turn chrom:start-end regions (0-based, half-open; contig names may contain colons) into
# "padded-region <tab> nominal-start" lines. A bare contig name is passed through unchanged.
padded=$(mktemp)
trap 'rm -f "$padded"' EXIT
while IFS= read -r region || [ -n "$region" ]; do
    region=${region%$'\r'}
    [ -z "$region" ] && continue
    range=${region##*:}
    case $range in
        *-*) chrom=${region%:*}; start=${range%-*}; end=${range#*-}
             from=$(( start - overlap )); [ "$from" -lt 0 ] && from=0
             printf '%s:%s-%s\t%s\n' "$chrom" "$from" "$end" "$start" ;;
        *)   printf '%s\t0\n' "$region" ;;
    esac
done < "$regionsfile" > "$padded"

command=("freebayes" "$@")

(
# iterate over regions using gnu parallel to dispatch jobs, dropping the records that fall in
# the overlap (they belong to the upstream region)
parallel -k -j "$ncpus" --colsep '\t' "${command[@]}" --region {1} '|' awk -v start={2} "'/^#/ || \$2 > start'" < "$padded"
) | vcffirstheader \
    | vcfstreamsort -w 1000 | vcfuniq # remove duplicates at region edges
